$TTL    86400
@       IN      SOA     darthvader.starwars.lan. brais.starwars.lan. (
                                       2 ; Serial
                                    3600 ; Refresh
                                    1800 ; Retry
                                 1209600 ; Expire
                                 86400 ) ; Negative Cache TTL

; Servidores de nomes
@       IN      NS      darthvader.starwars.lan.
@       IN      NS      darthsidious.starwars.lan.

